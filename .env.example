# Upstash Redis — use a MESMA base nos projetos Store e Admin
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Login administrativo Google
# Crie um OAuth Client ID do tipo Web Application no Google Cloud.
GOOGLE_CLIENT_ID=
# Somente este e-mail poderá entrar no painel.
ADMIN_GOOGLE_EMAIL=
# Segredo usado para assinar a sessão HttpOnly.
ADMIN_SESSION_SECRET=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Gemini
GEMINI_API_KEY=
GEMINI_EDITOR_MODEL=gemini-3.1-pro-preview

# Asaas
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
